+    gs_regions[i].usable = usable;
+    #ifdef MADV_NOHUGEPAGE
+        madvise(base, usable < (2u << 20) ? usable : (2u << 20), MADV_NOHUGEPAGE);
+    #endif
+    gs_lazy_on[s] = 1;
+    return 1;
+}
+#endif
