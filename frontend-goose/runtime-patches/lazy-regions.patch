+/* Main's reservation for all its regions, as it starts; none if the
+   platform refuses it, and every region is reserved on its own then. */
+static void gs_lazy_start(int64_t n) {
+    size_t per = gs_region_usable + gs_region_gap;
+    if (n <= 0 || n > INT32_MAX || per % gs_region_page || (uint64_t)n > (1ull << 47) / per) return;
+    gs_lazy_on = (uint8_t *)calloc((size_t)n, 1);
+    gs_lazy_slot = (int32_t *)malloc((size_t)n * sizeof(int32_t));
+    gs_lazy_reg = (int32_t *)malloc((size_t)n * sizeof(int32_t));
+    void *p = gs_lazy_on && gs_lazy_slot && gs_lazy_reg
+                  ? mmap(NULL, (size_t)n * per, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS
+                         #ifdef MAP_NORESERVE
+                             | MAP_NORESERVE
+                         #endif
+                         , -1, 0)
+                  : MAP_FAILED;
+    if (p == MAP_FAILED) {
+        free(gs_lazy_on);
+        free(gs_lazy_slot);
+        free(gs_lazy_reg);
+        gs_lazy_on = NULL;
+        gs_lazy_slot = gs_lazy_reg = NULL;
+        return;
+    }
+    /* The hot regions first, in the list's order, then the others in
+       registry order. */
+    int32_t s = 0;
+    for (int32_t i = 0; i < (int32_t)n; i++) gs_lazy_slot[i] = -1;
+    #ifdef GS_HOT_REGIONS
+        for (size_t k = 0; k < sizeof(gs_hot_regions) / sizeof(gs_hot_regions[0]); k++) {
+            int32_t i = gs_hot_regions[k];
+            if (i >= 0 && i < (int32_t)n && gs_lazy_slot[i] < 0) {
+                gs_lazy_on[s] = 2;
+                gs_lazy_slot[i] = s++;
+            }
+        }
+    #endif
+    for (int32_t i = 0; i < (int32_t)n; i++)
+        if (gs_lazy_slot[i] < 0) gs_lazy_slot[i] = s++;
+    for (int32_t i = 0; i < (int32_t)n; i++) gs_lazy_reg[gs_lazy_slot[i]] = i;
+    #ifdef GS_REGION_PROFILE
+        atexit(gs_lazy_profile);    /* a return from main; gs_end calls it too */
+    #endif
+    gs_lazy_per = per;
+    gs_lazy_usable = gs_region_usable;
+    gs_lazy_slots = (long)n;
+    gs_lazy_used = 0;
+    gs_lazy_base = (uint8_t *)p;
+}
+
+#ifdef GS_REGION_PROFILE
+/* -DGS_REGION_PROFILE: the registry indices of the regions the run made
+   accessible, on stderr as it ends, for choosing GS_HOT_REGIONS. */
+static void gs_lazy_profile(void) {
+    static int done;
+    if (!gs_lazy_base || done++) return;
+    fprintf(stderr, "goose regions touched:");
+    for (long i = 0; i < gs_lazy_used; i++) {
+        uint8_t *p = gs_lazy_base + (size_t)gs_lazy_slot[i] * gs_lazy_per;
+        /* A hot region is accessible from the start: count it if its
+           stack's top moved, or its first page is resident. */
+        unsigned char vec = 0;
+        if (gs_lazy_on[gs_lazy_slot[i]] == 1 &&
+            (gs_regions[i].stack->top != p || (!mincore(p, 1, &vec) && (vec & 1))))
+            fprintf(stderr, " %ld", i);
+    }
+    fprintf(stderr, "\n");
+}
+#endif
