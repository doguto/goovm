+#ifdef GS_LAZY_REGIONS
+/* The first access to a lazy slot's usable part: makes it accessible, and
+   returns 1 so the access is retried. Where the platform will not commit
+   that much (strict overcommit accounting counts a writable private
+   mapping in full), the usable part halves, down to GS_REGION_MIN, as
+   gs_reserve_region halves a refused reservation: the rest of it is guard
+   gap. 0 for anything else: the gap, an accessible slot, not a slot. */
+static int gs_lazy_enable(uint8_t *hit) {
+    uintptr_t off = (uintptr_t)hit - (uintptr_t)gs_lazy_base;
+    if (!gs_lazy_base || off >= (uintptr_t)gs_lazy_slots * gs_lazy_per) return 0;
+    long s = (long)(off / gs_lazy_per), i = gs_lazy_reg[s];
+    if (i >= gs_lazy_used || gs_lazy_on[s] == 1 || off % gs_lazy_per >= gs_lazy_usable) return 0;
+    uint8_t *base = gs_lazy_base + (size_t)s * gs_lazy_per;
+    size_t usable = gs_lazy_usable;
+    while (mprotect(base, usable, PROT_READ | PROT_WRITE)) {
+        if (usable <= (1u << 20)) return 0;    /* GS_REGION_MIN */
+        usable /= 2;
+        usable -= usable % gs_region_page;
+        if ((uintptr_t)(hit - base) >= usable) {
+            /* The access is past what the platform gives: a genuine
+               overflow of the smaller region. */
+            gs_regions[i].usable = usable;
+            return 0;
+        }
