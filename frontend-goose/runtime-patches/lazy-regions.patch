+        gs_panic("cannot release data stack address space");
+    gs_lazy_base = NULL;
+    gs_lazy_slots = gs_lazy_used = 0;
+    free(gs_lazy_on);
+    free(gs_lazy_slot);
+    free(gs_lazy_reg);
+    gs_lazy_on = NULL;
+    gs_lazy_slot = gs_lazy_reg = NULL;
+}
+#endif
