+static size_t gs_lazy_per, gs_lazy_usable;  /* per slot: all of it, the usable part */
+static long gs_lazy_slots;              /* how many it holds: main's regions */
+static volatile long gs_lazy_used;      /* how many are registered */
+static int32_t *gs_lazy_slot, *gs_lazy_reg; /* registry index -> slot, and back */
+static uint8_t *gs_lazy_on;             /* per slot: 1 accessible, 2 hot, 0 neither */
+#ifdef GS_HOT_REGIONS
+static const int32_t gs_hot_regions[] = { GS_HOT_REGIONS };
+#endif
+#endif
